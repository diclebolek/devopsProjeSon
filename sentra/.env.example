# Copy to sentra/.env for host processes. Docker Compose sets its own values.
# These are lab defaults, not production secrets.

# Ingest
SENTRA_HTTP_ADDR=:8088
SENTRA_STORE=memory
SENTRA_DATABASE_URL=postgres://sentra:sentra@127.0.0.1:5433/sentra?sslmode=disable
SENTRA_MQTT_BROKER=tcp://127.0.0.1:1883
SENTRA_MQTT_CLIENT_ID=sentra-ingest
SENTRA_LOG_LEVEL=info
SENTRA_LOG_FORMAT=text

# Simulator
SENTRA_TRANSPORT=http
SENTRA_INGEST_URL=http://127.0.0.1:8088
SENTRA_DEVICE_ID=motor-lab-01
SENTRA_FIRMWARE_VERSION=0.1.0
SENTRA_REGIME=cycle
SENTRA_REGIME_PERIOD=8
SENTRA_INTERVAL_MS=1000
SENTRA_MAX_FRAMES=0
SENTRA_SEED=1

# Edge host binary (firmware stand-in)
SENTRA_SAMPLE_RATE_HZ=1000
SENTRA_WINDOW_SAMPLES=256
SENTRA_PUBLISH_INTERVAL_MS=1000
SENTRA_WIFI_RSSI_DBM=-65
